{
  "manifest_version": 3,
  "name": "ARX SGA",
  "version": "1.1.0",
  "description": "Entra sozinho no SGA Hinova com os logins guardados (cifrados) e resolve o erro de cookies acumulados.",
  "permissions": [
    "storage",
    "cookies"
  ],
  "host_permissions": [
    "https://*.hinova.com.br/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_title": "ARX SGA",
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icones/16.png",
      "32": "icones/32.png",
      "48": "icones/48.png",
      "128": "icones/128.png"
    }
  },
  "content_scripts": [
    {
      "matches": [
        "https://*.hinova.com.br/sga/*/v5/login.php*"
      ],
      "js": [
        "cortina.js"
      ],
      "run_at": "document_start"
    },
    {
      "matches": [
        "https://*.hinova.com.br/sga/*"
      ],
      "js": [
        "regras.js",
        "conteudo.js"
      ],
      "run_at": "document_idle"
    }
  ],
  "icons": {
    "16": "icones/16.png",
    "32": "icones/32.png",
    "48": "icones/48.png",
    "128": "icones/128.png"
  }
}
