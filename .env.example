POSTGRES_PASSWORD=change_me_before_deploying
GLPI_BASE_URL=https://your-glpi-host/api.php/v1
GLPI_APP_TOKEN=change_me_generate_in_glpi_api_settings
GLPI_ENTITY_ID=1

# Opcionais
# CHECK_INTERVAL_MS=15000
# CHECK_TIMEOUT_MS=3000
# Pasta dos tutoriais em vídeo do botão "?" (videos gerada em Documentacao-Automacoes); sem ela o botão não aparece
# TUTORIAIS_DIR=C:/Users/Carlos/Desktop/Documentacao-Automacoes/videos

# Segredo que o chamados-glpi usa para ler o GLPI escolhido em Administração > GLPI (scripts/gerar-segredo-servico.sh no
# ARX-Automacoes grava o mesmo valor aqui e no chamados-glpi/.env). GLPI_BASE_URL/GLPI_APP_TOKEN acima viram o padrão de produção.
HUB_SERVICO_TOKEN=
GLPI_SITE_URL=
